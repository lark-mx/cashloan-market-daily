---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = '全球现金贷市场情报中心', description = '拉美与东南亚消费金融风险、监管和市场机会情报' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#07111f" />
  <title>{title}</title>
  <script is:inline>
    const saved = localStorage.getItem('theme');
    if (saved === 'light') document.documentElement.dataset.theme = 'light';
  </script>
</head>
<body>
  <div class="ambient ambient-a"></div><div class="ambient ambient-b"></div>
  <header class="topbar">
    <a class="brand" href={base}>
      <span class="brand-mark">MI</span>
      <span><b>Market Intelligence</b><small>全球现金贷市场情报</small></span>
    </a>
    <nav>
      <a href={base}>总览</a>
      <a href={`${base}markets/argentina/`}>阿根廷</a>
      <a href={`${base}markets/colombia/`}>哥伦比亚</a>
      <a href={`${base}markets/peru/`}>秘鲁</a>
      <a href={`${base}markets/vietnam/`}>越南</a>
    </nav>
    <button class="theme-toggle" aria-label="切换主题" data-theme-toggle>◐</button>
  </header>
  <main><slot /></main>
  <footer>
    <span>Cashloan Market Intelligence</span>
    <span>公开信息研究 · 不构成投资或法律建议</span>
    <a href="https://github.com/lark-mx/cashloan-market-daily">GitHub ↗</a>
  </footer>
  <script is:inline>
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const light = document.documentElement.dataset.theme === 'light';
      document.documentElement.dataset.theme = light ? '' : 'light';
      localStorage.setItem('theme', light ? 'dark' : 'light');
    });
  </script>
</body>
</html>
