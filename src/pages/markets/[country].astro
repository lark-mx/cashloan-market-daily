---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarketCard from '../../components/MarketCard.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){return ['argentina','colombia','peru','vietnam','mexico','guatemala','dominican-republic','kenya'].map(country=>({params:{country}}));}
const { country }=Astro.params; const reports=(await getCollection('reports')).filter(r=>r.data.country===country).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime()); const latest=reports[0]; const root=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title={`${latest?.data.countryName||country}市场档案`}>
<div class="page-shell archive-page"><a class="back-link" href={root}>← 返回全球市场总览</a><section class="archive-hero"><span>{latest?.data.flag}</span><div><span class="eyebrow">MARKET ARCHIVE</span><h1>{latest?.data.countryName}市场档案</h1><p>历史日报、风险评分与市场判断归档。</p></div></section><section class="section-head"><div><span class="eyebrow">REPORT ARCHIVE</span><h2>全部日报</h2></div><p>共 {reports.length} 期</p></section><section class="market-grid single">{reports.map(report=><MarketCard report={report}/>)}</section></div>
</BaseLayout>
